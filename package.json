{
  "name": "videosdk-switch-webcam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:switch-webcam": "vite build --base=/switch-webcam/ --outDir build/switch-webcam --emptyOutDir",
    "preview:switch-webcam": "vite preview --base=/switch-webcam/ --outDir build/switch-webcam --port 4173"
  },
  "dependencies": {
    "@videosdk.live/react-sdk": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
